# Copy to backend/.env for local development. Never commit the real file.
# All values below are placeholders.

APP_ENV=development            # development | production
PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error

# Runtime connection. For Supabase use the pooler (transaction mode, port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/referral?sslmode=disable
# Direct (non-pooled) connection used for migrations; falls back to DATABASE_URL.
# Supabase: the "direct connection" string (port 5432). Migrations need advisory locks,
# which PgBouncer transaction mode does not support.
MIGRATION_DATABASE_URL=
AUTO_MIGRATE=false             # true = run migrations at API start

# Supabase Auth. The API verifies tokens through the project's JWKS.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Optional overrides (defaults derive from SUPABASE_URL):
# SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Only for legacy HS256 projects or local dev (cmd/devtoken). Leave EMPTY in production
# if your project uses asymmetric signing keys.
SUPABASE_JWT_SECRET=

# Comma-separated list of exact frontend origins. Required in production, no wildcard.
ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=30

# ---- Gmail integration (optional; set all four together to enable) ----
# Create an OAuth client (type "Web application") in Google Cloud Console, enable the Gmail API,
# and add GOOGLE_REDIRECT_URL as an authorized redirect URI. Scope used: gmail.readonly only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must point at THIS API: https://<api-host>/oauth/gmail/callback (https required in production)
GOOGLE_REDIRECT_URL=http://localhost:8080/oauth/gmail/callback
# Encrypts refresh tokens at rest (AES-256-GCM). Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Where the OAuth callback sends the browser afterwards (your deployed frontend).
FRONTEND_URL=http://localhost:5173
GMAIL_SYNC_MAX_MESSAGES=50     # new messages handled per manual sync
GMAIL_LOOKBACK_DAYS=30         # window for the very first sync

# ---- Rate limiting (per authenticated user, in memory) ----
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=60
